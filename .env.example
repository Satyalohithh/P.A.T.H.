# Copy this file to .env and adjust. All values are optional (defaults in code).

# Environment: development | production
SAFEWATCH_ENV=development

# Logging
SAFEWATCH_LOG_LEVEL=INFO
SAFEWATCH_LOG_FORMAT=json

# Stream / ingestion
SAFEWATCH_MAX_FRAME_RATE=30

# API
SAFEWATCH_API_HOST=0.0.0.0
SAFEWATCH_API_PORT=8000
SAFEWATCH_API_WORKERS=1

# Storage (PostgreSQL)
SAFEWATCH_DATABASE_URL=postgresql+psycopg://safewatch:safewatch@localhost:5432/safewatch

# Model registry / experiment tracking
SAFEWATCH_MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
SAFEWATCH_DEFAULT_MODEL_YAML=configs/detection/yolov8n.yaml